{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/laofahai/mark-doc/main/schemas/markdoc-package-v1.schema.json",
  "title": "MarkDoc Package Manifest v1",
  "type": "object",
  "required": ["format", "version", "entry", "schema", "spec"],
  "additionalProperties": true,
  "properties": {
    "format": {
      "const": "markdoc-package"
    },
    "version": {
      "const": 1
    },
    "entry": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "schema": {
      "type": "string",
      "format": "uri",
      "const": "https://raw.githubusercontent.com/laofahai/mark-doc/main/schemas/markdoc-package-v1.schema.json"
    },
    "spec": {
      "type": "string",
      "format": "uri",
      "const": "https://github.com/laofahai/mark-doc/blob/main/docs/spec/markdoc-package-v1.md"
    },
    "createdBy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string"
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "screen": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z][A-Za-z0-9+.-]*:).+\\.css$"
        },
        "print": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z][A-Za-z0-9+.-]*:).+\\.css$"
        },
        "docxReference": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z][A-Za-z0-9+.-]*:).+\\.docx$"
        },
        "page": {
          "type": "object",
          "additionalProperties": true,
          "required": ["size", "orientation", "margins"],
          "properties": {
            "size": {
              "enum": ["a4", "letter"]
            },
            "orientation": {
              "enum": ["portrait", "landscape"]
            },
            "margins": {
              "type": "object",
              "additionalProperties": true,
              "required": ["top", "right", "bottom", "left"],
              "properties": {
                "top": {
                  "type": "string",
                  "pattern": "^(?:0(?:\\.\\d+)?|[1-9]\\d?(?:\\.\\d+)?)(?:mm|cm|in|pt)$"
                },
                "right": {
                  "type": "string",
                  "pattern": "^(?:0(?:\\.\\d+)?|[1-9]\\d?(?:\\.\\d+)?)(?:mm|cm|in|pt)$"
                },
                "bottom": {
                  "type": "string",
                  "pattern": "^(?:0(?:\\.\\d+)?|[1-9]\\d?(?:\\.\\d+)?)(?:mm|cm|in|pt)$"
                },
                "left": {
                  "type": "string",
                  "pattern": "^(?:0(?:\\.\\d+)?|[1-9]\\d?(?:\\.\\d+)?)(?:mm|cm|in|pt)$"
                }
              }
            }
          }
        }
      }
    }
  }
}
