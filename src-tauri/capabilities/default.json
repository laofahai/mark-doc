{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-set-title",
    "shell:default",
    "opener:default",
    {
      "identifier": "fs:allow-watch",
      "allow": [
        { "path": "$TEMP/markdoc" },
        { "path": "$TEMP/markdoc/*" },
        { "path": "$TEMP/markdoc/**/*" },
        { "path": "/tmp/markdoc" },
        { "path": "/tmp/markdoc/*" },
        { "path": "/tmp/markdoc/**/*" },
        { "path": "/private/tmp/markdoc" },
        { "path": "/private/tmp/markdoc/*" },
        { "path": "/private/tmp/markdoc/**/*" }
      ]
    },
    {
      "identifier": "fs:allow-unwatch"
    },
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",
    "updater:default",
    "process:default"
  ]
}
